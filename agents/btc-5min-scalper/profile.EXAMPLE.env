# ============================================
# BTC 5-Min Polymarket Scalper — Agent Config
# ============================================
# Copy this to profile.env and fill in your keys.
# Start with: python main.py --profile btc-5min-scalper
# ============================================

# ── LLM (not strictly required — strategy is rule-based) ──
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.1:8b

# ── Trading core ──
TRADING_ENABLED=true
TRADING_PAPER_MODE=true
TRADING_AUTO_TRADE=true
TRADING_STRATEGIES=polymarket_btc_5min
TRADING_SCAN_INTERVAL=5

# Watchlist: the symbol is the 5-min BTC condition_id on Polymarket.
# You'll need to update this with the actual live condition_id.
# The scan loop in the runner script resolves the current round's
# YES/NO token IDs automatically.
TRADING_WATCHLIST=polymarket-btc-5min

# ── Risk limits (conservative for scalping) ──
TRADING_MAX_POSITION_PCT=2.0
TRADING_MAX_DAILY_LOSS_PCT=5.0
TRADING_MAX_DRAWDOWN_PCT=10.0
TRADING_MAX_OPEN_POSITIONS=2
TRADING_MAX_ORDER_USD=20
TRADING_REQUIRE_APPROVAL_ABOVE_USD=50

# ── Polymarket (REQUIRED for live trading) ──
# Your Polygon-chain private key (funds USDC on Polygon).
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=

# ── BTC price feed (at least one exchange key for live prices) ──
# Binance public API works without keys for market data.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Agent behavior ──
AGENT_NAME=BTC-5min-Scalper
AGENT_PERSONALITY=disciplined
AUTONOMOUS_MODE=true
AUTONOMOUS_ENABLED=true
AUTONOMOUS_CHECK_INTERVAL=5
HEARTBEAT_INTERVAL=10
LOG_LEVEL=INFO
